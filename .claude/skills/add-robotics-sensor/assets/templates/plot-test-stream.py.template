# {{NN}}-plot-test-stream.py
#
# Streams every channel from {{SENSOR_NAME}} to the Thonny Plotter. Each
# channel is independently rescaled to 0-100 using its own running min/max,
# so a small-range signal (e.g. a magnetometer in gauss) stays visible on
# the same graph as a large-range one (e.g. a gyroscope in degrees/second)
# instead of looking flat. Modeled on
# src/kits/9-dof-imu/03-plot-test-stream.py - this pattern generalizes to
# any multi-channel sensor, not just IMUs.
#
# Load this file onto the Pico with Thonny and run it (F5), then open
# View > Plotter to see every channel graphed live.
import time
import machine
import config
# {{import whatever driver(s) this kit uses}}

i2c = machine.SoftI2C(sda=machine.Pin(config.I2C_SDA_PIN), scl=machine.Pin(config.I2C_SCL_PIN), freq=100000)
# {{initialize the sensor driver(s) here}}

NUM_CHANNELS = {{N}}  # one entry per value read_all() below returns
channel_mins = [None] * NUM_CHANNELS
channel_maxs = [None] * NUM_CHANNELS


def autoscale(values):
    scaled = []
    for i, v in enumerate(values):
        if channel_mins[i] is None or v < channel_mins[i]:
            channel_mins[i] = v
        if channel_maxs[i] is None or v > channel_maxs[i]:
            channel_maxs[i] = v
        span = channel_maxs[i] - channel_mins[i]
        # A channel that hasn't moved yet has zero span - park it at the
        # midpoint instead of dividing by zero.
        scaled.append(50.0 if span == 0 else (v - channel_mins[i]) / span * 100)
    return scaled


try:
    while True:
        # {{read every channel into one flat tuple, e.g.:}}
        # values = sensor.read_a() + sensor.read_b() + ...
        scaled = autoscale(values)
        print(" ".join("{:.1f}".format(v) for v in scaled))
        time.sleep_ms(100)
except KeyboardInterrupt:
    print("Got ctrl-c, stopping")
