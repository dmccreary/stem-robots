    #     else:
    #         print("{{CHIP_NAME}} WHO_AM_I: 0x{:02X} - unexpected value".format(who))
    # else:
    #     print("No device at {{CHIP_NAME}} address 0x{:02X}".format(config.{{CHIP}}_I2C_ADDRESS))

    # --- Technique B: no identity register - write a setting, read it back
    # if config.{{CHIP}}_I2C_ADDRESS in devices:
    #     i2c.writeto_mem(config.{{CHIP}}_I2C_ADDRESS, {{SOME_CTRL_REGISTER}}, bytes([{{VALUE}}]))
    #     readback = i2c.readfrom_mem(config.{{CHIP}}_I2C_ADDRESS, {{SOME_CTRL_REGISTER}}, 1)[0]
    #     if readback == {{VALUE}}:
    #         print("{{CHIP_NAME}} register readback confirmed")
    #     else:
    #         print("{{CHIP_NAME}} register readback: 0x{:02X} - unexpected".format(readback))

    # --- Technique C: fixed identification bytes at a known address ------
    # if config.{{CHIP}}_I2C_ADDRESS in devices:
    #     idbytes = i2c.readfrom_mem(config.{{CHIP}}_I2C_ADDRESS, {{ID_REGISTER}}, {{N}})
    #     if tuple(idbytes) == {{EXPECTED_TUPLE}}:
